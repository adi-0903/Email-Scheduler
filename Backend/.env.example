# ── ReachInbox Outbound Engine - Backend Deployment Config ──

# ── Database (Neon PostgreSQL connection string with SSL) ──
DATABASE_URL="postgresql://neondb_owner:password@ep-plain-silence-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Redis (Redis Cloud / Upstash / Redis Stack for BullMQ delayed queue) ──
# Recommended format:
REDIS_URL="redis://default:password@host:port"

# Or separate fields:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Server ──
# Port is usually injected automatically by Render / Railway / Heroku / Fly.io ($PORT)
PORT=4000
BASE_URL=https://your-backend-service.onrender.com

# ── BullMQ Worker ──
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_SENDS_MS=2000

# ── Per-Sender Rate Limiting ──
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# ── Slack OAuth Integration (Optional) ──
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=https://your-backend-service.onrender.com/api/slack/callback

# ── Elasticsearch (Optional) ──
ELASTICSEARCH_URL=http://localhost:9200
