# ── ReachInbox Outbound Engine - Frontend Deployment Config ──

# The public HTTPS URL of your deployed backend (e.g., Render, Railway, Fly.io, AWS)
# Leave without trailing slash.
VITE_BACKEND_URL=https://email-scheduler-jqgy.onrender.com

# The public WebSocket URL (optional, automatically derived from VITE_BACKEND_URL as wss://)
VITE_WS_URL=wss://email-scheduler-jqgy.onrender.com/ws/delivery

# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
